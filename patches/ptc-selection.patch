+/// `shuffling_random_value` for consecutive iterations, hashing once per 16 (or 32) of them.
+struct ShufflingRandomValues {
+    preimage: Vec<u8>,
+    seed_len: usize,
+    electra: bool,
+    cached: Option<(usize, [u8; 32])>,
+}
+
+impl ShufflingRandomValues {
+    fn new(seed: &[u8], electra: bool) -> Self {
+        let mut preimage = Vec::with_capacity(seed.len().saturating_add(8));
+        preimage.extend_from_slice(seed);
+        preimage.extend_from_slice(&[0; 8]);
+        Self {
+            preimage,
+            seed_len: seed.len(),
+            electra,
+            cached: None,
+        }
+    }
+
+    fn get(&mut self, i: usize) -> Result<u64, BeaconStateError> {
+        let per_hash = if self.electra { 16 } else { 32 };
+        let block = i.safe_div(per_hash)?;
+        let digest = match self.cached {
+            Some((cached_block, digest)) if cached_block == block => digest,
+            _ => {
+                self.preimage.truncate(self.seed_len);
+                self.preimage
+                    .extend_from_slice(&int_to_bytes8(block as u64));
+                let digest = ethereum_hashing::hash_fixed(&self.preimage);
+                self.cached = Some((block, digest));
+                digest
+            }
+        };
+        let offset = i.safe_rem(per_hash)?;
+        if self.electra {
+            let start = offset.safe_mul(2)?;
+            digest
+                .get(start..start.safe_add(2)?)
+                .and_then(|bytes| bytes.try_into().ok())
+                .map(|bytes| u64::from(u16::from_le_bytes(bytes)))
+                .ok_or(BeaconStateError::ShuffleIndexOutOfBounds(start))
+        } else {
+            digest
+                .get(offset)
+                .map(|&byte| u64::from(byte))
+                .ok_or(BeaconStateError::ShuffleIndexOutOfBounds(offset))
+        }
+    }
+}
